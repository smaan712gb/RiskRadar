# RiskRadar API Service — Production Docker Build
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# Copy everything and install
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @riskradar/database exec prisma generate
RUN pnpm --filter @riskradar/api exec tsc

# Production image
FROM node:20-alpine AS runner
RUN addgroup --system riskradar && adduser --system --ingroup riskradar api
WORKDIR /app

# Copy built output and all dependencies
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

USER api
EXPOSE 3001
ENV NODE_ENV=production
WORKDIR /app/apps/api
CMD ["node", "dist/server.js"]
