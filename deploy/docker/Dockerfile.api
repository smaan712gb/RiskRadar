# RiskRadar API Service — Production Build
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
RUN npm install -g tsx
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @riskradar/database exec prisma generate

RUN addgroup --system riskradar && adduser --system --ingroup riskradar api
RUN chown -R api:riskradar /app

USER api
EXPOSE 3001
ENV NODE_ENV=production
CMD ["tsx", "apps/api/src/server.ts"]
