# RiskRadar API Service — Production Build
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
RUN npm install -g tsx prisma@6.19.2
WORKDIR /app

COPY . .
RUN echo "shamefully-hoist=true" > .npmrc && pnpm install

# Generate Prisma client from database package directory
ENV PRISMA_GENERATE_SKIP_AUTOINSTALL=true
RUN cd packages/database && prisma generate

RUN addgroup --system riskradar && adduser --system --ingroup riskradar api
RUN chown -R api:riskradar /app

USER api
EXPOSE 3001
ENV NODE_ENV=production
CMD ["tsx", "apps/api/src/server.ts"]
