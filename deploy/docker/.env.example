# RiskRadar Production Environment
# Copy to .env and fill in all required values

# ─── Database ─────────────────────────────────────────────
DB_USER=riskradar
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=riskradar
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
REDIS_PORT=6379

# ─── Security ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_GENERATED_WITH_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX_STRING_FOR_AES256_ENCRYPTION

# ─── Ports ────────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
INFERENCE_PORT=8080

# ─── AI Inference Mode ────────────────────────────────────
# Options: local, cloud, hybrid
#   local  — Full on-premises (requires NVIDIA GPU)
#   cloud  — Use Claude/GPT API (no GPU needed, data leaves network)
#   hybrid — Local for routine, cloud for complex (PII stripped)
INFERENCE_MODE=local

# ─── Local Models (for INFERENCE_MODE=local or hybrid) ────
NEMOCLAW_ENDPOINT=http://inference:8080
NEMOTRON_SUPER_MODEL=nvidia/Nemotron-3-Super-120B-A12B
NEMOTRON_CASCADE_MODEL=nvidia/Nemotron-Cascade-2-30B-A3B
MODEL_TIMEOUT_MS=30000

# ─── Cloud Models (for INFERENCE_MODE=cloud or hybrid) ────
PRIVACY_ROUTER_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info

# ─── Notifications (optional) ────────────────────────────
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=alerts@yourcompany.com
