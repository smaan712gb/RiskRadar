# RiskRadar Web Dashboard — Production Build
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=https://riskradar-api-680928579719.us-central1.run.app/api/v1
RUN pnpm --filter @riskradar/web exec next build

RUN addgroup --system riskradar && adduser --system --ingroup riskradar web
RUN chown -R web:riskradar /app

USER web
EXPOSE 3000
ENV NODE_ENV=production
ENV PORT=3000
CMD ["pnpm", "--filter", "@riskradar/web", "exec", "next", "start", "-p", "3000"]
