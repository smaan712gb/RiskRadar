# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://riskradar:riskradar_dev@localhost:5432/riskradar?schema=public"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API Server ───────────────────────────────────────────────
API_HOST="0.0.0.0"
API_PORT="3001"
API_BASE_URL="http://localhost:3001"
NODE_ENV="development"

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-64-char-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Web Dashboard ───────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXTAUTH_SECRET="change-me-in-production-use-64-char-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI Models (NemoClaw / Local Inference) ──────────────────
NEMOCLAW_ENDPOINT="http://localhost:8080"
NEMOTRON_SUPER_MODEL="nemotron-3-super-120b-a12b"
NEMOTRON_CASCADE_MODEL="nemotron-cascade-2-30b-a3b"
MODEL_TIMEOUT_MS="30000"

# ─── OpenClaw Agent Gateway ──────────────────────────────────
OPENCLAW_GATEWAY_PORT="3002"
OPENCLAW_DATA_DIR="./data/openclaw"

# ─── Privacy Router (Optional Cloud Fallback) ────────────────
PRIVACY_ROUTER_ENABLED="false"
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# ─── Notifications ───────────────────────────────────────────
# SLACK_WEBHOOK_URL=""
# SLACK_BOT_TOKEN=""
# TEAMS_WEBHOOK_URL=""
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# ─── Observability ───────────────────────────────────────────
LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="riskradar"

# ─── Encryption ──────────────────────────────────────────────
ENCRYPTION_KEY="change-me-32-byte-hex-key-for-field-encryption"
