generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANTS (Multi-tenant isolation) ────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  roles        Role[]
  alerts       Alert[]
  cases        Case[]
  evidence     Evidence[]
  policies     Policy[]
  integrations Integration[]
  auditLogs    AuditLog[]
  riskScores   RiskScore[]
  signals      Signal[]

  @@map("tenants")
}

// ─── USERS & AUTH ────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  role         String    @default("analyst")
  permissions  String[]  @default([])
  isActive     Boolean   @default(true)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens  RefreshToken[]
  assignedAlerts Alert[]        @relation("AssignedAlerts")
  reviewedAlerts Alert[]        @relation("ReviewedAlerts")
  assignedCases  Case[]         @relation("AssignedCases")
  createdCases   Case[]         @relation("CreatedCases")
  caseComments   CaseComment[]
  auditLogs      AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("roles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── ALERTS ─────────────────────────────────────────────────

model Alert {
  id                    String   @id @default(cuid())
  tenantId              String
  title                 String
  description           String
  alertType             String
  severity              String
  status                String   @default("new")
  compoundScore         Float
  confidenceScore       Float
  falsePositiveLikelihood String @default("medium")
  domains               String[]
  subjectType           String
  subjectId             String
  assignedTo            String?
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewNotes           String?
  dismissReason         String?
  caseId                String?
  evidenceBrief         Json?
  regulatoryMapping     Json     @default("[]")
  modelVersion          String
  reasoningModelUsed    String
  processingTimeMs      Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  assignee     User?          @relation("AssignedAlerts", fields: [assignedTo], references: [id])
  reviewer     User?          @relation("ReviewedAlerts", fields: [reviewedBy], references: [id])
  case         Case?          @relation(fields: [caseId], references: [id])
  evidence     Evidence[]
  alertSignals AlertSignal[]

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([tenantId, subjectId])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedTo])
  @@index([tenantId, alertType])
  @@map("alerts")
}

model AlertSignal {
  alertId  String
  signalId String

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([alertId, signalId])
  @@map("alert_signals")
}

// ─── CASES ──────────────────────────────────────────────────

model Case {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String
  status      String    @default("open")
  priority    String
  subjectType String
  subjectId   String
  assignedTo  String?
  createdBy   String
  slaDeadline DateTime?
  resolvedAt  DateTime?
  resolution  String?
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  assignee User?         @relation("AssignedCases", fields: [assignedTo], references: [id])
  creator  User          @relation("CreatedCases", fields: [createdBy], references: [id])
  alerts   Alert[]
  evidence Evidence[]
  comments CaseComment[]

  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, assignedTo])
  @@index([tenantId, createdAt])
  @@map("cases")
}

model CaseComment {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([caseId, createdAt])
  @@map("case_comments")
}

// ─── EVIDENCE ───────────────────────────────────────────────

model Evidence {
  id           String   @id @default(cuid())
  tenantId     String
  alertId      String?
  caseId       String?
  evidenceType String
  title        String
  description  String
  sourceSystem String
  sourceId     String?
  dataSnapshot Json
  timestamp    DateTime
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  alert  Alert? @relation(fields: [alertId], references: [id])
  case   Case?  @relation(fields: [caseId], references: [id])

  @@index([tenantId, alertId])
  @@index([tenantId, caseId])
  @@map("evidence")
}

// ─── POLICIES ───────────────────────────────────────────────

model Policy {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  description       String
  policyType        String
  domain            String
  rules             Json
  naturalLanguage   String?
  isActive          Boolean   @default(true)
  version           Int       @default(1)
  previousVersionId String?
  regulatoryRef     String?
  createdBy         String
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@index([tenantId, domain])
  @@index([tenantId, policyType])
  @@map("policies")
}

// ─── INTEGRATIONS ───────────────────────────────────────────

model Integration {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  integrationType String
  provider        String
  config          Json
  credentials     Json
  status          String    @default("inactive")
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  syncSchedule    String?
  healthCheckUrl  String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId, status])
  @@map("integrations")
}

// ─── AUDIT LOGS (Immutable, append-only) ────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorType String
  actorId   String
  action    String
  resource  String
  resourceId String
  details   Json
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, timestamp])
  @@index([tenantId, resource, resourceId])
  @@index([tenantId, actorId])
  @@index([tenantId, action])
  @@map("audit_logs")
}

// ─── RISK SCORES ────────────────────────────────────────────

model RiskScore {
  id           String   @id @default(cuid())
  tenantId     String
  subjectType  String
  subjectId    String
  overallScore Float
  domainScores Json
  trajectory   String   @default("new")
  trendData    Json?
  modelVersion String
  calculatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, calculatedAt])
  @@index([tenantId, overallScore])
  @@map("risk_scores")
}

// ─── SIGNALS (TimescaleDB hypertable — see migration SQL) ───

model Signal {
  id           String    @id @default(cuid())
  tenantId     String
  domain       String
  signalType   String
  subjectType  String
  subjectId    String
  sourceSystem String
  value        Float?
  metadata     Json
  normalizedAt DateTime?
  timestamp    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, domain, timestamp])
  @@index([tenantId, subjectId, timestamp])
  @@index([tenantId, signalType, timestamp])
  @@map("signals")
}

// ─── AUTO-LEARNING STATE ────────────────────────────────────

model LearningState {
  id              String   @id @default(cuid())
  tenantId        String
  learningType    String
  key             String
  state           Json
  lastUpdatedAt   DateTime @default(now())
  version         Int      @default(1)

  @@unique([tenantId, learningType, key])
  @@index([tenantId, learningType])
  @@map("learning_states")
}

// ─── DIGITAL TWIN BASELINES ────────────────────────────────

model DigitalTwin {
  id             String   @id @default(cuid())
  tenantId       String
  roleArchetype  String
  department     String?
  baselineData   Json
  sampleSize     Int
  confidenceLevel Float
  lastCalculated DateTime @default(now())
  version        Int      @default(1)

  @@unique([tenantId, roleArchetype, department])
  @@index([tenantId, roleArchetype])
  @@map("digital_twins")
}

// ─── FEEDBACK LOOP (for adaptive thresholds) ────────────────

model AlertFeedback {
  id          String   @id @default(cuid())
  tenantId    String
  alertId     String
  alertType   String
  severity    String
  domains     String[]
  compoundScore Float
  outcome     String
  feedbackBy  String
  feedbackAt  DateTime @default(now())
  notes       String?

  @@index([tenantId, alertType, outcome])
  @@index([tenantId, feedbackAt])
  @@map("alert_feedback")
}

// ─── REGULATORY KNOWLEDGE ───────────────────────────────────

model RegulatoryRule {
  id             String   @id @default(cuid())
  framework      String
  section        String
  title          String
  description    String
  requirements   Json
  signalMappings Json
  industries     String[]
  jurisdictions  String[]
  effectiveDate  DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([framework, section])
  @@index([isActive])
  @@map("regulatory_rules")
}

// ─── SAR DRAFTS ─────────────────────────────────────────────

model SarDraft {
  id            String    @id @default(cuid())
  tenantId      String
  caseId        String
  alertIds      String[]
  status        String    @default("draft")
  narrative     String
  subjectInfo   Json
  activityDescription String
  timeline      Json
  evidenceCitations Json
  regulatoryRefs Json
  filingDeadline DateTime?
  generatedBy   String
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, caseId])
  @@map("sar_drafts")
}
